//*******************************************************
// ShoreSide Config File

ServerHost = localhost
ServerPort = 9000
Community  = shoreside

#include plugs.moos <origin_warp>
  
//--------------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pMarineViewer   @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pPointAssign    @ NewConsole = false //Distribute Points
  Run = uTimerScript    @ NewConsole = false //Generate 100 points
}

#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// uFldShoreBroker Config Block

ProcessConfig = uFldShoreBroker
{
  AppTick   = 1
  CommsTick = 1

  qbridge  = DEPLOY, NODE_REPORT
  qbridge  = STATION_KEEP, APPCAST_REQ
  qbridge  = MOOS_MANUAL_OVERRIDE
  qbridge  = REFUEL_NEEDED
  qbridge  = TSP_DONE

  bridge   = src=RETURN_ALL,         alias=RETURN
  bridge   = src=RETURN_$V,          alias=RETURN

  // Send pPointAssign's targeted point assignments to each vehicle.
  // qbridge expands VISIT_POINT into VISIT_POINT_ALL,
  // VISIT_POINT_HENRY, VISIT_POINT_GILDA, ... on shoreside,
  // and aliases them to VISIT_POINT in the vehicle community.
  qbridge  = VISIT_POINT
}

//--------------------------------------------------
// pLogger Config Block

ProcessConfig = pLogger
{
  AppTick 	= 10
  CommsTick = 10
  
  File		  = XLOG_SHORESIDE
  PATH      = ./
  SyncLog 	= true @ 0.2
  AsyncLog 	= true
  FileTimeStamp = true

  // Log all
  LogAuxSrc = true
  WildCardLogging = true 

  // Visit_Point register and log
  Log = VISIT_POINT       @ 0 nosync
  Log = VISIT_POINT_HENRY @ 0 nosync
  Log = VISIT_POINT_GILDA @ 0 nosync

  CompressAlogs = false
}

//--------------------------------------------------------
// pMarineViewer Config Block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = forrest19.tif
  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicles_shape_scale = 1.5
  vehicles_name_mode   = names+shortmode

	nodes_font_size = xlarge
	procs_font_size = xlarge
	appcast_font_size = large
	
  point_viewable_labels   = true
  polygon_viewable_labels = false
  appcast_viewable     = true
  appcast_color_scheme = indigo
  hash_delta           = 50
  hash_viewable        = true
  hash_shade           = 0.35

  scope = PHI_HOST_INFO
  scope = TIMER_REMAIN
  scope = VISIT_POINT
  scope = VIEW_POINT
  scope = VISIT_POINT_HENRY
  scope = VISIT_POINT_GILDA

  button_one   = DEPLOY  # DEPLOY_ALL=true
  button_one   = MOOS_MANUAL_OVERRIDE_ALL=false
  button_one   = RETURN_ALL=false
  button_one   = REFUEL_NEEDED_ALL=false
  button_one   = STATION_KEEP_ALL=false
  button_one   = TSP_DONE_ALL=false

  button_two   = RETURN  # RETURN_ALL=true
  button_two   = STATION_KEEP_ALL=false
  button_two   = REFUEL_NEEDED_ALL=false

  button_three = STATION  # STATION_KEEP_ALL=true
  button_three = REFUEL_NEEDED_ALL=false

  button_four  = REFUEL # REFUEL_NEEDED_ALL=true
  button_four  = RETURN_ALL=false
  button_four  = STATION_KEEP_ALL=false
}

//--------------------------------------------------------
// uTimerScript Config Block
ProcessConfig = uTimerScript
{
  AppTick   = 4
  CommsTick = 4
  
  script_name = tsp_points //Script Name

  paused      = true
  pause_var = UTS_PAUSE

  rand_var = varname=XPOS, min=-25,  max=200, key=at_post, snap=1
  rand_var = varname=YPOS, min=-175, max=-25, key=at_post, snap=1
  
  // Start of points
  event = var=VISIT_POINT, val="firstpoint", time=0
  
  // Generate 100 points
  event = var=VISIT_POINT, val="x=$[XPOS],y=$[YPOS],id=$[TCOUNT]", time=0, amt=100
 
  // End of points
  event = var=VISIT_POINT, val="lastpoint", time=0
}

//--------------------------------------------------------
// pPointAssign Config Block

ProcessConfig = pPointAssign
{
  AppTick   = 4
  CommsTick = 4

  vnames = $(VNAMES)

  // false = alternate points between vehicles
  // true  = split points by west/east region
  assign_by_region = true
  wait_for_ready   = true
  unpause_timer    = true

  region_xmin = -25
  region_xmax = 200
  region_ymin = -175
  region_ymax = -25
}




