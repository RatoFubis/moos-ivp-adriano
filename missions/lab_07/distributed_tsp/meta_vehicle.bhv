//-----------------------------------------------
// Helm Behavior file 

initialize   DEPLOY  = true
initialize   RETURN  = false
initialize   REFUEL_NEEDED  = false
initialize   STATION_KEEP = false
initialize   LOITER  = false
initialize   TSP_DONE = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = SURVEYING {
  MODE = ACTIVE
  RETURN = false
  REFUEL_NEEDED = false
  STATION_KEEP = false
}

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
} 

set MODE = REFUELING {
  MODE = ACTIVE
  REFUEL_NEEDED = true
}

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}                       

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
} 


//----------------------------------------------
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE==LOITERING

   post_suffix = A
         speed = 1.2
     clockwise = false
        radius = 8.0
     nm_radius = 15.0
       polygon = radial::$(LOITER_POS), radius=20, pts=8, snap=1, label=$(VNAME)_LOITER

  visual_hints = nextpt_color=white, nextpt_lcolor=khaki
  visual_hints = edge_color=orange, vertex_color=white
  visual_hints = edge_size=1, vertex_size=2
}

//----------------------------------------------
// Dynamic TSP waypoint behavior. pGenPath posts
// WPT_UPDATE = points = pts={...} after all assigned
// VISIT_POINT messages have been received.
Behavior = BHV_Waypoint
{
  name      = waypt_tsp
  pwt       = 100
  condition = MODE==SURVEYING
  condition = TSP_DONE != true

  updates   = WPT_UPDATE

      speed = 1.2
     radius = 3.0
  nm_radius = 15.0
  slip_radius = 15.0
  perpetual = false
       lead = 8

  endflag   = TSP_DONE = true
  endflag   = RETURN = true
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = MODE==RETURNING
  condition = REFUEL_NEEDED == false
  endflag   = STATION_KEEP = true
  perpetual = true

      speed = 1.2
     radius = 3.0
  nm_radius = 15.0
     points = start
       lead = 8
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_refuel
  pwt       = 100
  condition = MODE==REFUELING
  condition = STATION_KEEP == false  // Only runs during transit phase
  endflag   = STATION_KEEP = true    // Triggers the 60s dock phase
  perpetual = true

      speed = 1.2
     radius = 3.0
  nm_radius = 15.0
     points = start
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep
  pwt       = 100
  // Activated during STATION-KEEPING mode AND the docking phase of REFUELING
  condition = STATION_KEEP == true

  center_activate = true
     inner_radius = 5
     outer_radius = 10 
      outer_speed = 1.0
    transit_speed = 1.2
       swing_time = 7
     visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
Behavior = BHV_Timer
{
  name      = need_refuel_timer
  pwt       = 100

  condition = STATION_KEEP == false
  condition = REFUEL_NEEDED == false
  
  perpetual = true
  duration_reset = REFUEL_NEEDED=true
  duration  = 600
  
  endflag   = REFUEL_NEEDED = true
}

//----------------------------------------------
Behavior = BHV_Timer
{
  name      = refuel_timer
  pwt       = 100
  condition = MODE==REFUELING
  condition = STATION_KEEP == true
  
  perpetual = true
  duration_reset = REFUEL_NEEDED=true

  duration  = 60

  updates = TIMER_REMAIN

  endflag   = REFUEL_NEEDED = false
  endflag   = STATION_KEEP = false
}

