ServerHost = localhost
ServerPort = 9000
Community  = apples

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB	 @ NewConsole = false
  Run = pLogger	 @ NewConsole = false
  Run = pXRelay	 @ NewConsole = true
  Run = uXMS	 @ NewConsole = true
  Run = pShare   @ NewConsole = false
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AsyncLog = true
  WildCardLogging = true
}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  // Listen here for incoming shared variables
  input  = route = localhost:9200

  // Send APPLES to the pears community
  output = src_name=APPLES, route=localhost:9201
}

//------------------------------------------
ProcessConfig = pXRelay
{
  AppTick   = 1
  CommsTick = 1

  INCOMING_VAR = APPLES
  OUTGOING_VAR = PEARS
}

//------------------------------------------
ProcessConfig = uXMS
{
  AppTick    = 4
  CommsTick  = 4

  PAUSED            = false
  DISPLAY_SOURCE    = true
  DISPLAY_TIME      = true
  DISPLAY_COMMUNITY = true

  VAR = APPLES
  VAR = PEARS
}
