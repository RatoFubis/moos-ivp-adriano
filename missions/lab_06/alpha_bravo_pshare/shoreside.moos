//-------------------------------------------------
// NAME: M. Benjamin, MIT CSAIL
// FILE: shoreside.moos
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = shoreline
MOOSTimeWarp = 20


// Forest Lake
LatOrigin  = 43.825300
LongOrigin = -70.330400


//------------------------------------------
// Antler configuration block

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB         @ NewConsole = false
  Run = pMarineViewer  @ NewConsole = false
  Run = pShare         @ NewConsole = false
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = forrest19.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size    = 1

  //---------------------------------------
  // Appcast

  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo

  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large

  //---------------------------------------
  // Scope variables

  scope = SUMMARY
  scope = RETURN
  scope = WPT_STAT
  scope = VIEW_SEGLIST
  scope = VIEW_POINT
  scope = VIEW_POLYGON
  scope = MVIEWER_LCLICK
  scope = MVIEWER_RCLICK

  //---------------------------------------
  // Buttons

  button_one = DEPLOY_ALL # DEPLOY_ALL=true # RETURN_ALL=false # MOOS_MANUAL_OVERRIDE=false
  button_two = RETURN_ALL # RETURN_ALL=true 
  button_three = SLOWER # WPT_UPDATE = speed=1.5
  button_four  = FASTER # WPT_UPDATE = speed=3.5

  //--------------------------------------- 
  // ACTION MENU 

  // Deploy all vehicles 
  action = MENU_KEY=deploy_all # DEPLOY_ALL=true 
  action = MENU_KEY=deploy_all # RETURN_ALL=false
  action+ = MENU_KEY=deploy_all # MOOS_MANUAL_OVERRIDE=false 

  // Return all vehicles 
  action+ = MENU_KEY=return_all # RETURN_ALL=true 

  // Deploy alpha only 
  action = MENU_KEY=deploy_alpha # DEPLOY_ALPHA=true 
  action = MENU_KEY=deploy_alpha # RETURN_ALPHA=false 
  action+ = MENU_KEY=deploy_alpha # MOOS_MANUAL_OVERRIDE=false
  
  // Return alpha only 
  action+ = MENU_KEY=return_alpha # RETURN_ALPHA=true 

  // Deploy bravo only 
  action = MENU_KEY=deploy_bravo # DEPLOY_BRAVO=true 
  action = MENU_KEY=deploy_bravo # RETURN_BRAVO=false
  action+ = MENU_KEY=deploy_bravo # MOOS_MANUAL_OVERRIDE=false 

  // Return bravo only 
  action+ = MENU_KEY=return_bravo # RETURN_BRAVO=true 

} 

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:9200


  // ----- DEPLOY logic -----
  output = src_name=DEPLOY_ALL,   dest_name=DEPLOY_ALPHA, route=localhost:9201
  output = src_name=DEPLOY_ALL,   dest_name=DEPLOY_BRAVO, route=localhost:9202
  
  output = src_name=DEPLOY_ALPHA, dest_name=DEPLOY_ALPHA, route=localhost:9201
  output = src_name=DEPLOY_BRAVO, dest_name=DEPLOY_BRAVO, route=localhost:9202

  // ----- RETURN logic -----
  output = src_name=RETURN_ALL,   dest_name=RETURN_ALPHA, route=localhost:9201
  output = src_name=RETURN_ALL,   dest_name=RETURN_BRAVO, route=localhost:9202

  output = src_name=RETURN_ALPHA, dest_name=RETURN_ALPHA, route=localhost:9201
  output = src_name=RETURN_BRAVO, dest_name=RETURN_BRAVO, route=localhost:9202

  //----------------------------------------
  // Direct vehicle updates

  output = src_name=WPT_UPDATE, dest_name=WPT_UPDATE, route=localhost:9201
  output = src_name=WPT_UPDATE, dest_name=WPT_UPDATE, route=localhost:9202

  output = src_name=MOOS_MANUAL_OVERRIDE, dest_name=MOOS_MANUAL_OVERRIDE, route=localhost:9201
  output = src_name=MOOS_MANUAL_OVERRIDE, dest_name=MOOS_MANUAL_OVERRIDE, route=localhost:9202
}
