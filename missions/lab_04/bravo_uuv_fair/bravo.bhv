//--------    FILE: bravo.bhv -------------

initialize DEPLOY = false
initialize RETURN = false
initialize LOITER_REGION = west
initialize SURFACE = false

//----------------------------------------------
// West path loiter
Behavior = BHV_Loiter
{
  name      = loiter_west
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = false
  condition = LOITER_REGION = west
  condition = SURFACE = false

  duration = 150
  duration_idle_decay = false
  perpetual = true

  endflag = LOITER_REGION = east

  speed          = 2.5
  clockwise      = false

  polygon = format=radial, x=100, y=-75, radius=30, pts=8, snap=1
}


//----------------------------------------------
// East path loiter
Behavior = BHV_Loiter
{
  name      = loiter_east
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = false
  condition = LOITER_REGION = east
  condition = SURFACE = false

  duration = 150
  duration_idle_decay = false
  perpetual = true

  endflag = LOITER_REGION = west

  speed          = 2.5
  clockwise      = false

  polygon = format=radial, x=160, y=-50, radius=20, pts=8, snap=1
}


//----------------------------------------------
// West path depth (30 m)
Behavior = BHV_ConstantDepth
{
  name      = depth_west
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = false
  condition = LOITER_REGION = west
  condition = SURFACE = false

  duration = no-time-limit

  depth = 30
}


//----------------------------------------------
// East path depth (10 m)
Behavior = BHV_ConstantDepth
{
  name      = depth_east
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = false
  condition = LOITER_REGION = east
  condition = SURFACE = false

  duration = no-time-limit

  depth = 10
}

//----------------------------------------------
//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = true

  perpetual = true

  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = complete

  speed          = 2.0
  capture_radius = 3.0
  slip_radius    = 10.0
  points = 0,0

}
//----------------------------------------------
//----------------------------------------------
Behavior = BHV_ConstantSpeed
{
  name      = const_speed
  pwt       = 200
  condition = SPD=true
  condition = DEPLOY = true
  perpetual = true
  updates   = SPEED_UPDATE
  endflag   = SPD = false

           speed = 0.5
		    duration = 10
	duration_reset = CONST_SPD_RESET=true
	
}

//----------------------------------------------
// Surface stop depth (0 m)
Behavior = BHV_ConstantDepth
{
  name      = depth_return
  pwt       = 100

  condition = DEPLOY = true
  condition = RETURN = true

  duration = no-time-limit

  depth = 0
}

//---------------------------------------------
//Surfacing protocol
//---------------------------------------------

// Trigger surfacing every 200s
Behavior = BHV_Timer
{
  name      = timer_submerged
  condition = DEPLOY = true
  condition = RETURN = false
  condition = SURFACE = false
  
  duration  = 200

  duration_idle_decay = false  
  perpetual = true
  
  endflag = SURFACE = true
}

//------------------------------------------
// 60 s timer on surface
Behavior = BHV_Timer
{
  name      = timer_surface_hold
 
  condition = DEPLOY = true
  condition = RETURN = false
  condition = SURFACE = true
  condition = NAV_DEPTH < 1  

  duration  = 60

  duration_idle_decay = false
  perpetual = true

  endflag   = SURFACE = false

}

//------------------------------------------
// Surface Rise Behavior
Behavior = BHV_ConstantDepth
{
  name      = surface_depth
  pwt       = 100

  condition = DEPLOY = true
  condition = SURFACE = true
  condition = RETURN = false

  depth = 0
  duration = no-time-limit
}

//------------------------------------------
// Stop Behavior
Behavior = BHV_ConstantSpeed
{
  name      = surface_stop
  pwt       = 100

  condition = DEPLOY = true
  condition = SURFACE = true
  condition = RETURN = false

  speed     = 0
  duration = no-time-limit

}

// Hold Direction
Behavior = BHV_ConstantHeading
{
  name      = heading_surface
  pwt       = 100

  condition = SURFACE = true
  condition = RETURN = false

  heading   = 0
  duration  = no-time-limit
}

//------------------------------------------
// Return when surfacing

Behavior = BHV_Timer
{
  name = cancel_surface_on_return

  condition = RETURN = true

  duration = 1
  perpetual = true

  endflag = SURFACE = false
}

